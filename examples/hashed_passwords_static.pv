(*
 * Attack scenarios on a database of hashed passwords.
 *
 * This is a static simplified version of the hashed_passwords_paper.pv model that can be translated to UPPPAL.
 *)

(* -lib primitives.pvl *)

(* UPPAAL
table_capacities:
    passwd: 10
attacker_resources:
    hack: 1
    compute: 2
attacker_cost_channel: cost
*)

(* database of hashed passwords and their salt *)
table passwd(bitstring, bitstring, bitstring).

(* server connection *)
channel server_link.
event server_user_authenticated(bitstring).

let server_app(server_secret: seckey) =
    in (server_link, ctu: bitstring);
    let u: bitstring = adec(ctu, server_secret) in
    in (server_link, ctpw: bitstring);
    let password: bitstring = adec(ctpw, server_secret) in
    get passwd(uid1, hashedpw: bitstring, salt: bitstring)
            suchthat uid1 = u in
        if hashed(password, salt) = hashedpw then
            event server_user_authenticated(u).

(* example user *)
free user1: bitstring.
free pw1: bitstring [ private ].
free salt1: bitstring [ private ].

channel leak.

(* no pw leakage *)
query attacker(pw1).
(* no hashed pw leakage *)
query attacker(hashed(pw1, salt1)).

(* price model *)
channel cost.
fun compute(nat): bitstring [data].
fun hack(nat): bitstring [data].

process
    new server_secret: seckey;
    insert passwd(user1, hashed(pw1, salt1), salt1);
    ( !server_app(server_secret)
    (* Honest user1 authenticating *)
    | !(
        out (server_link, aenc( user1, pk(server_secret) ));
        out (server_link, aenc( pw1, pk(server_secret) ))
    )
    (* Server compromised
    | !(
        in (cost, hack(4)); 
        out (leak, server_secret))  *)
    (* Rainbow table attack *)
    | !(
        in (leak, hashedpw: bitstring);
        in (leak, salt: bitstring);
        in (cost, compute(2));
        if hashedpw = hashed(pw1, salt1) && salt = salt1 then
            out (leak, pw1))
    (* Database leak *)
    | (in (cost, hack(1)); (* upfront cost! (not replicated) *)
        !
        in (leak, u: bitstring);
        get passwd(ui, hashedpw, salt) suchthat ui = u in
        out (leak, hashedpw);
        out (leak, salt))
    )