(*
 * Attack scenarios on a database of hashed passwords with singularization.
 *)

(* -lib primitives.pvl *)

(* database of hashed passwords and their salt *)
type uid.
table passwd(uid, bitstring, bitstring).

(* database of singularization secrets *)
table singularizations(uid, bitstring).
fun singularized(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring, r: bitstring;
    singularize(egenc(m, k), r) = egenc(singularized(m, r), k).

(* the singularization allows symmetric decryption *)
reduc forall m: bitstring, r: bitstring;
    unsingularize(singularized(m, r), r) = m.

fun msg1(uid): bitstring.
reduc forall u: uid, pw: bitstring;
    user(msg1(u)) = u.

(* server connection *)
channel server_link.
channel singularization_link.
channel answer_channel.
event server_user_authenticated(uid).

channel tick.
fun seconds(nat): bitstring [data].

(* singularization server. *)
let server_singularization(server_secret: seckey) =
    in(singularization_link, xu: bitstring);
    in(singularization_link, xs: bitstring);
    in(tick, seconds(3));
    let u = user(adec(xu, server_secret)) in
    let scrambled = adec(xs, server_secret) in
    get singularizations(uid1, r0: bitstring)
            suchthat uid1 = u in
        out(answer_channel, singularize(scrambled, r0)).

(* server checking user password. *)
let server_app(server_secret: seckey, singularization_server_pk: pubkey) =
    in(server_link, ct: bitstring);
    in(server_link, ct2: bitstring);
    in(tick, seconds(3));
    let u = user(adec(ct, server_secret)) in
    let pw = adec(ct2, server_secret) in
    new elgamal_secret: bitstring;
    out(
        singularization_link,
        aenc(
            msg1(u),
            singularization_server_pk
        )
    );
    out(
        singularization_link,
        aenc(
            egenc(pw, elgamal_secret),
            singularization_server_pk
        )
    );
    in(answer_channel, singularized_pw_enc: bitstring);
    let singularized_pw = egdec(singularized_pw_enc, elgamal_secret) in
    get passwd(uid1, hashedpw: bitstring, sa: bitstring)
            suchthat uid1 = u in
        if hashedpw = hashed(singularized_pw, sa) then
            event server_user_authenticated(u)
        else
            0.

(* example user *)
free user1: uid.
free pw1: bitstring [ private ].
free salt1: bitstring [ private ].
free singularization1: bitstring [ private ].

(* no pw leakage *)
query attacker(pw1).
(* no hashed pw leakage *)
query attacker(hashed(singularized(pw1, singularization1), salt1)).

(*** Rainbow table attack [4 compute]
reduc forall m: bitstring, s: bitstring;
    unhash(hashed(m, s), s) = m.
***)

process
    new server_secret: seckey;
    new singularization_server_secret: seckey;
    (*** Server compromised [4 hack]
    out (server_link, server_secret);
    ***)
    (*** Singularization server compromised [3 hack]
    out (server_link, singularization_server_secret);
    ***)
    insert singularizations(user1, singularization1);
    insert passwd(user1, hashed(singularized(pw1, singularization1), salt1), salt1);
    ( !server_app(server_secret, pk(singularization_server_secret))
    | server_singularization(singularization_server_secret)
    | out (server_link, aenc( msg1(user1), pk(server_secret) ));
      out (server_link, aenc( pw1, pk(server_secret) ))
    (*** Database leak [1 hack] {unlocking_time: 2, mitigation_time: 1}
    | (!get passwd(u, hashedpw, salt) in
         in (tick, seconds(2));
         out (server_link, (u, hashedpw, salt)))
    ***)
    (*** Singularization database leak [1 hack] {unlocking_time: 1, mitigation_time: 2}
    | (!get singularizations(u, r0) in
         in (tick, seconds(3));
         out (server_link, (u, r0)))
    ***)
    )
